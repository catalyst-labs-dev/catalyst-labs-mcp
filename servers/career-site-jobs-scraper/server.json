    "subfolder": "servers/career-site-jobs-scraper"
  },
  "icons": [
    {
      "src": "https://apify-image-uploads-prod.s3.us-east-1.amazonaws.com/1ydY5YsykVmyMWtQX-actor-3bd7Pfnzvdb8C9NbR-wXPWRFZrFG-IMG_9676.png",
      "mimeType": "image/png"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
