{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.catalyst-labs-dev/podcast-transcript-api",
  "title": "Podcast Transcript API",
  "description": "Podcast transcripts: publisher's own for $0.01, else Whisper; budget-capped, never overspends.",
  "version": "1.0.1",
  "websiteUrl": "https://apify.com/catalyst-labs/podcast-transcript-api",
  "repository": {
    "url": "https://github.com/catalyst-labs-dev/catalyst-labs-mcp",
    "source": "github",
    "subfolder": "servers/podcast-transcript-api"
  },
  "icons": [
    {
      "src": "https://apify-image-uploads-prod.s3.us-east-1.amazonaws.com/1ydY5YsykVmyMWtQX-actor-5jdK5z2K6EbJoWdZd-Fhh5Pn5i9A-IMG_9682.jpeg",
      "mimeType": "image/jpeg"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=catalyst-labs/podcast-transcript-api",
      "headers": [
        {
          "name": "Authorization",
          "description": "Apify API token as 'Bearer <token>' (console.apify.com/settings/integrations). Optional if your MCP client supports OAuth: the server returns 401 with OAuth discovery and you sign in with Apify instead.",
          "value": "Bearer {apify_token}",
          "isRequired": false,
          "isSecret": true,
          "variables": {
            "apify_token": {
              "description": "Your Apify API token",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
