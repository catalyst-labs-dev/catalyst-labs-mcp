{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.catalyst-labs-dev/city-council-meeting-transcripts",
  "title": "City Council & Public Meeting Transcripts",
  "description": "Timestamped city council and county board meeting transcripts with agenda items and votes.",
  "version": "1.0.0",
  "websiteUrl": "https://apify.com/catalyst-labs/city-council-meeting-transcripts",
  "repository": {
    "url": "https://github.com/catalyst-labs-dev/catalyst-labs-mcp",
    "source": "github",
    "subfolder": "servers/city-council-meeting-transcripts"
  },
  "icons": [
    {
      "src": "https://apify-image-uploads-prod.s3.us-east-1.amazonaws.com/1ydY5YsykVmyMWtQX-actor-aDAl66nBjRaXL3H7h-yvVe63UwYA-IMG_9709.png",
      "mimeType": "image/png"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.apify.com/?tools=catalyst-labs/city-council-meeting-transcripts",
      "headers": [
        {
          "name": "Authorization",
