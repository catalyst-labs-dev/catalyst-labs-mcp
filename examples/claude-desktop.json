{
  "mcpServers": {
    "career-site-jobs-scraper": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.apify.com/?tools=catalyst-labs/career-site-jobs-scraper",
        "--header",
        "Authorization: Bearer ${APIFY_TOKEN}"
      ],
      "env": {
        "APIFY_TOKEN": "<your-apify-token>"
      }
    },
    "website-screenshot-pdf-api": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.apify.com/?tools=catalyst-labs/website-screenshot-pdf-api",
        "--header",
        "Authorization: Bearer ${APIFY_TOKEN}"
      ],
      "env": {
        "APIFY_TOKEN": "<your-apify-token>"
      }
    },
    "youtube-transcript-api": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.apify.com/?tools=catalyst-labs/youtube-transcript-api",
        "--header",
        "Authorization: Bearer ${APIFY_TOKEN}"
      ],
      "env": {
        "APIFY_TOKEN": "<your-apify-token>"
      }
    },
    "podcast-transcript-api": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.apify.com/?tools=catalyst-labs/podcast-transcript-api",
